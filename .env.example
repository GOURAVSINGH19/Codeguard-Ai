# Copy to apps/web/.env.local and fill in real values. Never commit real secrets.

# ── Database (Neon) ─────────────────────────────────────────────
# Pooled string (host contains "-pooler"): used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct string (pooling off): used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Kafka (Day 2) ───────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── GitHub App (Day 1.3) ────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=codeguard-ai-dev
# PEM key on one line, newlines written as \n
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# ── Clerk (read by @clerk/nextjs directly) ──────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── AI model (Day 2) ────────────────────────────────────────────
LLM_PROVIDER=groq                     # groq | openai
# LLM_MODEL=openai/gpt-oss-120b       # optional override; see your provider's model list
GROQ_API_KEY=gsk_xxx
# OPENAI_API_KEY=sk-xxx
# REVIEW_MAX_DIFF_TOKENS=12000

# Public URL of the web app (links from GitHub comments to the review page)
APP_URL=http://localhost:3000

# ── Hosted Kafka (Aiven, Confluent…). Leave empty for local Docker. ─
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=xxx
# KAFKA_SASL_MECHANISM=scram-sha-256  # plain | scram-sha-256 | scram-sha-512
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# or client-certificate auth:
# KAFKA_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n..."
# KAFKA_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n..."
