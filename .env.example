# CodeGuard AI — environment variables for apps/web and apps/workers.
# Copy to apps/web/.env.local and apps/workers/.env and fill in the values.
# Every variable is validated at startup by packages/config/src/env.ts.

NODE_ENV=development
LOG_LEVEL=info                     # debug | info | warn | error

# ─── Clerk (web only) ────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Database (Neon Postgres + pgvector) ─────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── Review model ────────────────────────────────────────────────────────────
# groq | openai. Each provider only ever uses its own key.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4.1-mini
# LLM_MODEL=                       # overrides the provider's model
# LLM_TIMEOUT_MS=60000

# Embeddings for RAG (workers) always use OpenAI
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ─── GitHub App ──────────────────────────────────────────────────────────────
# App settings → enable "Request user authorization (OAuth) during installation"
# and set the Setup URL to https://<your-app>/api/github/app/callback
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=codeguard-ai
GITHUB_APP_CLIENT_ID=Iv1....
GITHUB_APP_CLIENT_SECRET=...
# PEM; "\n" sequences are converted to newlines
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Webhook secret (openssl rand -hex 32). Required outside development.
GITHUB_APP_WEBHOOK_SECRET=
# Optional: secret for legacy repository webhooks pointing at /api/webhooks/github
# GITHUB_WEBHOOK_SECRET=
# Development only: personal token used when a repo has no App installation
# GITHUB_TOKEN=

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SASL_MECHANISM=scram-sha-256
# TLS certificate checks are ON by default when credentials are set.
# Only set this to false for a local broker with a self-signed certificate.
# KAFKA_SSL_REJECT_UNAUTHORIZED=true

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
REVIEW_RATE_LIMIT_PER_HOUR=30
