# Copy to apps/web/.env.local and fill in real values. Never commit real secrets.

# ── Database (Neon) ─────────────────────────────────────────────
# Pooled string (host contains "-pooler"): used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct string (pooling off): used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Kafka (Day 2) ───────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── GitHub App (Day 1.3) ────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=codeguard-ai-dev
# PEM key on one line, newlines written as \n
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# ── Clerk (read by @clerk/nextjs directly) ──────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
