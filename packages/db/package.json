{
  "name": "@codeguard/db",
  "version": "0.0.0",
  "description": "Database package with Drizzle ORM + Neon Postgres + pgvector",
  "main": "./index.ts",
  "types": "./index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./schema": {
      "types": "./schema/index.ts",
      "default": "./schema/index.ts"
    },
    "./client": {
      "types": "./client.ts",
      "default": "./client.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
