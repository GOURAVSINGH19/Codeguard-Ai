# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk redirect URLs — set these in Clerk dashboard too
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Database ────────────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
# Use the POOLED connection string for serverless (has -pooler in hostname)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── AI ───────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=groq | openai — each provider uses only its own key
LLM_PROVIDER=groq
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
REVIEW_RATE_LIMIT_PER_HOUR=30

# ─── Kafka (Upstash) ─────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → Kafka → your cluster → Details
KAFKA_BROKERS=your-cluster.upstash.io:9092
KAFKA_USERNAME=your-username
KAFKA_PASSWORD=your-password

# ─── GitHub App ───────────────────────────────────────────────────────────────
# See the root .env.example for details. Enable "Request user authorization
# (OAuth) during installation" so the install callback can verify ownership.
GITHUB_APP_ID=
GITHUB_APP_SLUG=codeguard-ai
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Required outside development — unsigned webhooks are rejected.
GITHUB_APP_WEBHOOK_SECRET=
# Optional legacy repository-webhook secret (/api/webhooks/github)
GITHUB_WEBHOOK_SECRET=
