{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@codeguard/db": ["../../packages/db/index.ts"],
      "@codeguard/db/*": ["../../packages/db/*"],
      "@codeguard/types": ["../../packages/types/src/index.ts"],
      "@codeguard/types/*": ["../../packages/types/src/*"],
      "@codeguard/kafka": ["../../packages/kafka/src/index.ts"],
      "@codeguard/kafka/*": ["../../packages/kafka/src/*"]
    }
  },
  "include": ["src"]
}
