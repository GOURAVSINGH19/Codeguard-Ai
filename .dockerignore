# Git
.git
.gitignore

# Node modules anywhere (rebuilt inside Docker). A bare "node_modules" only
# matches the root one — local per-package installs would overwrite the image's.
**/node_modules

# Next.js web app build artefacts — not needed by the worker
apps/web/.next
apps/web/node_modules

# Dev/editor files
.vscode
.kiro
.agents
*.md
!README.md

# Test files
**/__tests__
**/*.test.ts
**/*.spec.ts
vitest.config.ts

# Environment files (inject as env vars in Render dashboard)
**/.env
**/.env.*

# Docker build context extras
docker-compose.yml
*.log
