{
  "name": "codeguard-ai",
  "version": "1.0.0",
  "description": "CodeGuard AI — AI pull-request reviewer (rebuilding from scratch)",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @codeguard/db db:generate",
    "db:migrate": "pnpm --filter @codeguard/db db:migrate",
    "db:studio": "pnpm --filter @codeguard/db db:studio",
    "infra:up": "docker compose -f docker-compose.yml up -d",
    "test": "pnpm -r --if-present test",
    "dev:worker": "pnpm --filter workers dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {}
}
