{
  "name": "codeguard-ai",
  "version": "1.0.0",
  "description": "CodeGuard AI \u2014 AI pull-request reviewer (Next.js web app + Kafka workers)",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter workers dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @codeguard/db db:generate",
    "db:migrate": "pnpm --filter @codeguard/db db:migrate",
    "db:check": "pnpm --filter @codeguard/db exec drizzle-kit check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@vitest/ui": "2.1.8",
    "next": "16.3.5",
    "vitest": "2.1.8"
  }
}
